  "description": "",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:manifest && npm run watch",
    "watch": "rollup -c -w",
    "serve": "npx serve -p 4333 www ",
    "standalone": "npm run build && npm run standalone:serve",
    "standalone:serve": "node scripts/standalone.mjs",
    "standalone:desktop": "npm run build && electron .",
    "desktop": "electron .",
    "serve-2": "jsproject --serve www --port 4332",
    "generate:manifest": "node generate-manifest.js",
    "build": "npm run generate:manifest && rollup -c",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@leofcoin/storage": "^3.5.38",
    "@material/web": "^2.5.0",
    "@vandeurenglenn/custom-elements": "^0.1.22",
    "@vandeurenglenn/flex-elements": "^1.4.0",
    "@vandeurenglenn/lite-elements": "^0.4.3",
    "@vandeurenglenn/little-pubsub": "^1.5.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
