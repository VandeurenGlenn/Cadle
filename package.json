{
  "name": "cadle",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:manifest && npm run watch",
    "watch": "rollup -c -w",
    "serve": "npx serve -p 4433 www ",
    "standalone": "npm run build && npm run standalone:serve",
    "standalone:serve": "node scripts/standalone.mjs",
    "standalone:desktop": "npm run build && electron .",
    "desktop": "electron .",
    "serve-2": "jsproject --serve www --port 4332",
    "generate:manifest": "node generate-manifest.js",
    "symbols:audit": "node scripts/svg-symbols.mjs --audit",
    "symbols:preview": "node scripts/svg-symbol-preview.mjs",
    "symbols:convert": "node scripts/convert-visio-symbols.mjs",
    "symbols:validate": "node scripts/svg-symbols.mjs",
    "onewire:model:train": "node scripts/train-onewire-model.mjs",
    "build": "npm run generate:manifest && rollup -c",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run symbols:validate && npm test && npm run typecheck && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@leofcoin/peernet": "^3.1.1",
    "@leofcoin/storage": "^3.5.38",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@vandeurenglenn/flex-elements": "^1.4.0",
    "@vandeurenglenn/lite-elements": "^0.4.5",
    "@vandeurenglenn/little-pubsub": "^1.5.2",
    "events": "^3.3.0",
    "hash.js": "^1.1.7",
    "jspdf": "^4.2.1",
    "lit": "^3.3.3",
    "lit-html": "^3.3.3",
    "pdfjs-dist": "^6.4.299",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vandeurenglenn/lite": "^1.3.0",
    "electron": "^45.2.0",
    "rollup": "^4.67.2",
    "rollup-plugin-css-modules": "^0.2.0",
    "rollup-plugin-material-symbols": "^2.1.7",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "@mapbox/node-pre-gyp": "^2.0.3"
  }
}
